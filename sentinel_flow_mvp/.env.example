# =============================================================================
# Sentinel-Flow — Example Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values for your local environment.
# Sensitive values (API keys, tokens) should go in `.secrets.json` instead.
# See `app/core/vault.py` for details on the vault mechanism.
#
#   cp .env.example .env
#   cp .secrets.example.json .secrets.json   (fill in your real keys)
#
# NEVER commit `.env` or `.secrets.json` to version control.
# =============================================================================

APPLICATION_NAME=Sentinel-Flow
APPLICATION_VERSION=0.1.0
DEBUG_MODE=false
DATABASE_URL=postgresql://postgres:postgrespassword@timescaledb:5432/sentinel_db

# ---- Secrets (prefer vault over .env) ----
# API_KEY and GEMINI_API_KEY are loaded from .secrets.json by default.
# You can also set them here as environment variables in production.
# API_KEY=changeme
# GEMINI_API_KEY=changeme
# WEATHER_API_KEY=changeme
# TRENDS_API_KEY=changeme

# ---- Infrastructure ----
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ---- ML Training Defaults ----
ML_TRAIN_BATCH_SIZE=4
ML_TRAIN_EPOCHS=5
ML_LEARNING_RATE=3e-4
ML_GRADIENT_ACCUMULATION_STEPS=4
ADAPTER_STORAGE_PATH=/app/data/adapters

# ---- Geographic Fallbacks (Kochi, Kerala) ----
FALLBACK_LAT=9.9312
FALLBACK_LON=76.2673
FALLBACK_CITY=Kochi
